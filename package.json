    "verify:institute-pdf": "node --experimental-strip-types scripts/verify-institute-field-manual-pdf.mjs",
    "verify:institute-render": "node scripts/verify-institute-book-render.mjs",
    "verify:article-sources": "node scripts/verify-article-sources.mjs",
